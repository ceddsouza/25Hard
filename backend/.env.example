# Production Database (set in Render dashboard)
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=your_db_host.internal
DB_PORT=5432
DB_NAME=your_db_name

# JWT Secret (generate a random string)
JWT_SECRET=change_this_to_random_string_min_32_chars

# Challenge Password
CHALLENGE_PASSWORD=25Hard

# SendGrid Email Reminders
SENDGRID_API_KEY=SG.your_api_key_here
SENDGRID_FROM_EMAIL=noreply@25hard.com

# Firebase Photo Storage
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY_ID=your_key_id
FIREBASE_PRIVATE_KEY=your_private_key
FIREBASE_CLIENT_EMAIL=your_service_account_email
FIREBASE_CLIENT_ID=your_client_id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=your_cert_url

# Server
PORT=5000
NODE_ENV=production
